model User {
    id           String   @id @default(uuid()) @db.Uuid
    firstName    String
    lastName     String
    email        String   @unique
    password     String
    role         Role     @default(USER)
    refreshToken String?
    resetToken       String?
    resetTokenExpiry DateTime?
    isActive     Boolean  @default(true)
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt

    @@map("users")
}

enum Role {
    USER
    COURIER
    ADMIN
}
