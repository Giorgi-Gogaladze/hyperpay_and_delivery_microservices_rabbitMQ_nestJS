model Address {
    id String @id @default(uuid()) @db.Uuid
    userId String @db.Uuid

    fullName     String
    phoneNumber  String
    city         String
    street       String
    zipCode      String?
    isDefault    Boolean @default(false)


    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt


    @@map("addresses")
}