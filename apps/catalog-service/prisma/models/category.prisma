model Category {
    id                String  @id @default(uuid()) @db.Uuid
    name              String
    description       String? @default("No dascription provided") @db.Text
    slug              String  @unique
    thumbnailUrl      String?
    thumbnailPublicId String?
    isActive          Boolean @default(true)

    products Product[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([name])
    @@map("categories")
}
